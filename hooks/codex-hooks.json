{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|compaction|context_compacted",
        "hooks": [
          {
            "type": "command",
            "command": "ONMHJ_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-${ONMHJ_ROOT:-}}}\"; [ -n \"$ONMHJ_ROOT\" ] || exit 0; exec node \"$ONMHJ_ROOT/bin/onmhj.js\" hook SessionStart",
            "timeout": 5,
            "statusMessage": "Recording onmhj session..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ONMHJ_ROOT=\"${CLAUDE_PLUGIN_ROOT:-${CODEX_PLUGIN_ROOT:-${ONMHJ_ROOT:-}}}\"; [ -n \"$ONMHJ_ROOT\" ] || exit 0; exec node \"$ONMHJ_ROOT/bin/onmhj.js\" hook UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Recording onmhj prompt..."
          }
        ]
      }
    ]
  }
}
